{
	"info": {
		"_postman_id": "chaser-backend-api",
		"name": "Chaser Backend API",
		"description": "Complete API collection for Chaser Backend - Social Media App",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password@123\",\n  \"displayName\": \"John Doe\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"if (pm.response.code === 200) {",
								"    var jsonData = pm.response.json();",
								"    if (jsonData.tokens && jsonData.tokens.access) {",
								"        pm.environment.set('access_token', jsonData.tokens.access.token);",
								"        pm.environment.set('refresh_token', jsonData.tokens.refresh.token);",
								"    }",
								"}"
							]
						}
					}],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "logout"]
						}
					}
				},
				{
					"name": "Refresh Tokens",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/refresh-tokens",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "refresh-tokens"]
						}
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/forgot-password",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "forgot-password"]
						}
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"password\": \"NewPassword@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/reset-password?token=RESET_TOKEN_HERE",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "reset-password"],
							"query": [{"key": "token", "value": "RESET_TOKEN_HERE"}]
						}
					}
				},
				{
					"name": "Send Verification Email",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{access_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/v1/auth/send-verification-email",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "send-verification-email"]
						}
					}
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"JWT_TOKEN_HERE\",\n  \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/verify-email",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "verify-email"]
						}
					}
				},
				{
					"name": "Google Auth",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"action\": \"signup\",\n  \"token\": \"GOOGLE_OAUTH_TOKEN\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/auth/googleauth",
							"host": ["{{base_url}}"],
							"path": ["v1", "auth", "googleauth"]
						}
					}
				}
			]
		},
